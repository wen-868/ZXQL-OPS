# ===== 服务基础 =====
PORT=3100
NODE_ENV=development

# ===== 鉴权（与管理系统同名变量对齐；缺失将启动失败）=====
JWT_SECRET=请替换为强随机字符串-ops
CSRF_SECRET=请替换为强随机字符串-ops

# ===== 数据库（MySQL，独立库 zhixiang_ops）=====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=zhixiang_ops
DB_CONNECTION_LIMIT=10
DB_MAX_IDLE=10
DB_IDLE_TIMEOUT=30000
DB_QUEUE_LIMIT=0
DB_ACQUIRE_TIMEOUT=60000

# ===== Redis =====
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379

# ===== 域名 =====
DOMAIN=http://localhost:3100
API_DOMAIN=http://localhost:3100
ADMIN_DOMAIN=http://localhost:3100
MERCHANT_DOMAIN=http://localhost:3100

# ===== 跨域 =====
CORS_ORIGINS=http://localhost:3100

# ===== 日志 =====
LOG_LEVEL=info

# ===== 告警（飞书，可选）=====
FEISHU_WEBHOOK_URL=
FEISHU_ALERT_WEBHOOK_URL=

# ===== 运营系统专属（OPS_ 前缀）=====
# 能力网关 / 本地 LLM（Ollama）
OPS_LLM_GATEWAY=
OPS_OLLAMA_HOST=127.0.0.1
OPS_OLLAMA_PORT=11434
OPS_OLLAMA_MODEL=qwen2.5:7b
# 对象存储（素材/成片/直播录屏）
OPS_OSS_ENDPOINT=
OPS_OSS_BUCKET=
OPS_OSS_ACCESS_KEY=
OPS_OSS_SECRET_KEY=
# 抖音开放平台（发布，可选；不配则降级为模拟发布）
OPS_DOUYIN_APP_ID=
OPS_DOUYIN_APP_SECRET=
# FFmpeg 路径（可选；不配则自动从系统 PATH 或常见路径探测）
OPS_FFMPEG_PATH=

# ===== 管理系统对接（统一管理后台方案 v1.1）=====
# 双模式：standalone=独立自营（默认）；connected=经 SSO 打通管理系统
OPS_INTEGRATION_MODE=standalone
# 管理系统 API 基址（connected 模式使用）
OPS_MS_API_BASE=https://api.onepan.cn/api
# 服务账号凭证（P3 主数据同步使用；SSO 验签不依赖）
OPS_MS_CLIENT_ID=
OPS_MS_CLIENT_SECRET=
# SSO 签发的运营 token 有效期（建议跟随管理系统 4h）
OPS_SSO_TOKEN_TTL=4h
# 注意：SSO 验签要求本文件 JWT_SECRET 与管理系统服务器 JWT_SECRET 完全一致，否则 401
