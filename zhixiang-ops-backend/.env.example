# ===== 服务基础 =====
PORT=3100
NODE_ENV=development

# ===== 鉴权（缺失将启动失败；密钥强度须 >= 32 字符，占位符会被拒绝）=====
JWT_SECRET=请替换为强随机字符串-ops
CSRF_SECRET=请替换为强随机字符串-ops（缺省复用 JWT_SECRET，建议独立配置）

# ===== 管理系统 SSO 验签密钥（connected 模式使用；缺省复用 JWT_SECRET）=====
# 生产建议与管理系统的 JWT_SECRET 保持一致，或配置独立验签密钥
OPS_MS_JWT_SECRET=

# ===== 开放注册开关（true=允许匿名注册；生产环境建议 false）=====
OPS_ALLOW_REGISTER=true

# ===== 数据库（MySQL，独立库 zhixiang_ops）=====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=zhixiang_ops
# 内嵌 MySQL（自带数据库）：auto=内置二进制则托管启动；false=连接外部 DB
OPS_EMBEDDED_MYSQL=auto
OPS_MYSQL_HOME=
OPS_MYSQL_DATA_DIR=
OPS_MYSQL_STOP_ON_EXIT=false
DB_CONNECTION_LIMIT=10
DB_MAX_IDLE=10
DB_IDLE_TIMEOUT=30000
DB_QUEUE_LIMIT=0
DB_ACQUIRE_TIMEOUT=60000

# ===== Redis =====
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379

# ===== 域名 =====
DOMAIN=http://localhost:3100
API_DOMAIN=http://localhost:3100
ADMIN_DOMAIN=http://localhost:3100
MERCHANT_DOMAIN=http://localhost:3100

# ===== 跨域（生产必配；多个逗号分隔。未配置时生产环境将禁用跨域）=====
CORS_ORIGINS=http://localhost:3100

# ===== 日志 =====
LOG_LEVEL=info

# ===== 告警（飞书，可选）=====
FEISHU_WEBHOOK_URL=
FEISHU_ALERT_WEBHOOK_URL=

# ===== 运营系统专属（OPS_ 前缀）=====
# 能力网关 / 本地 LLM（Ollama）
OPS_LLM_GATEWAY=
OPS_LLM_GATEWAY_KEY=
OPS_OLLAMA_HOST=127.0.0.1
OPS_OLLAMA_PORT=11434
OPS_OLLAMA_MODEL=qwen2.5:7b
# 对象存储（素材/成片/直播录屏）
OPS_OSS_ENDPOINT=
OPS_OSS_BUCKET=
OPS_OSS_ACCESS_KEY=
OPS_OSS_SECRET_KEY=
# 抖音开放平台（发布，可选；不配则降级为模拟发布）
OPS_DOUYIN_APP_ID=
OPS_DOUYIN_APP_SECRET=
# FFmpeg 路径（可选；不配则自动从系统 PATH 或常见路径探测）
OPS_FFMPEG_PATH=

# ===== 管理系统对接（统一管理后台方案 v1.1）=====
# 双模式：standalone=独立自营（默认）；connected=经 SSO 打通管理系统
OPS_INTEGRATION_MODE=standalone
# 管理系统 API 基址（connected 模式使用）
OPS_MS_API_BASE=https://api.onepan.cn/api
# 服务账号凭证（P3 主数据同步使用；SSO 验签不依赖）
OPS_MS_CLIENT_ID=
OPS_MS_CLIENT_SECRET=
# SSO 签发的运营 token 有效期（建议跟随管理系统 4h）
OPS_SSO_TOKEN_TTL=4h
# 演示模式：开启后允许免密「演示登录」并在启动时自动种子演示数据
# ⚠️ 生产环境必须设为 false（免密登录 + 明文演示口令）
OPS_DEMO_MODE=false
OPS_DEMO_TENANT=t_demo
# 可用帐号密码登录（启动时会写入/重置）
OPS_DEMO_USERNAME=demo
OPS_DEMO_PASSWORD=Demo@123456

# ===== 浏览器工作台专属 =====
# Playwright 浏览器二进制文件路径 (Docker 部署时必需)
# 如果未配置，将使用 ms-playwright 缓存或需在构建时运行 npx playwright install chromium
OPS_BROWSER_EXECUTABLE=
# headless 模式 (生产环境建议 true，开发环境 false)
OPS_BROWSER_HEADLESS=true
# 浏览器启动参数（反检测相关；⚠️ 勿配置 --disable-web-security）
OPS_BROWSER_ARGS=--start-maximized --disable-blink-features=AutomationControlled
# WebSocket 连接超时时间 (秒)
OPS_WS_TIMEOUT=30
# 截图质量 (base64 编码长度限制)
OPS_SCREENSHOT_QUALITY=80
# 并发浏览器实例最大数 (防止资源耗尽)
OPS_MAX_BROWSER_INSTANCES=5
