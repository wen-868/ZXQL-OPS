{
  "name": "zhixiang-ops-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "智享全链运营系统 · 运营后台前端（Vue3 + Vite + Element Plus）",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "lint": "eslint \"src/**/*.{vue,ts}\" --max-warnings=0",
    "lint:fix": "eslint \"src/**/*.{vue,ts}\" --fix",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "preview": "vite preview",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.7.7",
    "element-plus": "^2.8.4",
    "pinia": "^2.2.4",
    "vue": "^3.5.12",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-vue": "^5.1.4",
    "@vitest/coverage-v8": "^2.1.9",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.8.1",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.67.0",
    "unplugin-vue-components": "^28.8.0",
    "vite": "^5.4.9",
    "vitest": "^2.1.9",
    "vue-tsc": "^2.1.10"
  }
}
